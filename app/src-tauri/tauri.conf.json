{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mentor",
  "version": "0.2.0",
  "identifier": "fr.mentor.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mentor",
        "width": 520,
        "height": 820,
        "minWidth": 380,
        "minHeight": 520,
        "backgroundColor": "#0f1115"
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Mentor overlay",
        "width": 280,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Mentor",
    "shortDescription": "Mentor, ton coach vocal pour World of Warcraft",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "resources/addon/Mentor/Mentor.toc": "addon/Mentor/Mentor.toc",
      "resources/addon/Mentor/Mentor.lua": "addon/Mentor/Mentor.lua",
      "resources/addon/Mentor/Inbox.lua": "addon/Mentor/Inbox.lua",
      "dlls/sherpa-onnx-c-api.dll": "sherpa-onnx-c-api.dll",
      "dlls/onnxruntime.dll": "onnxruntime.dll",
      "dlls/onnxruntime_providers_shared.dll": "onnxruntime_providers_shared.dll",
      "dlls/msvcp140.dll": "msvcp140.dll",
      "dlls/msvcp140_1.dll": "msvcp140_1.dll",
      "dlls/vcruntime140.dll": "vcruntime140.dll",
      "dlls/vcruntime140_1.dll": "vcruntime140_1.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
